# =============================================================================
# AI Quiz Platform - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and update the values
# NEVER commit .env.production to version control!
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=aiquiz
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_12345
POSTGRES_DB=aiquiz

# =============================================================================
# JWT Configuration
# =============================================================================
# Generate a strong secret using:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_128_CHARACTER_HEX_STRING_GENERATED_WITH_NODE_CRYPTO

# Signs anonymous guest identities. The backend falls back to JWT_SECRET when
# unset, but set it explicitly and keep it DIFFERENT from JWT_SECRET: a leaked
# guest secret must not double as a JWT signing key, and rotating one must not
# invalidate the other.
# REQUIRED in production — the backend refuses to boot if neither is set.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
GUEST_TOKEN_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_FOR_GUEST_SIGNING

# =============================================================================
# CORS Configuration
# =============================================================================
# Update with your actual domain
CORS_ORIGIN=https://yourdomain.com

# =============================================================================
# Frontend Configuration
# =============================================================================
# Frontend runs on port 3010
NEXT_PUBLIC_API_URL=http://localhost:3012/api

# Frontend origin used for OAuth redirects and verification/reset email links
# (required in production; must be a single origin, not a list)
FRONTEND_URL=https://yourdomain.com

# =============================================================================
# Email Configuration (verification & password-reset emails via Resend)
# =============================================================================
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
# =============================================================================
# Redis (docker-compose.prod.yml requires REDIS_PASSWORD in production)
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_use_a_long_random_value
# =============================================================================
# Proxy / rate limiting (SEC-11)
# Set when the app sits behind Cloudflare/Traefik so client IPs are read from
# X-Forwarded-For (required for per-IP rate limits and analytics geo).
# =============================================================================
TRUST_PROXY=true

# ============================================
# MEDIA OBJECT STORAGE (Cloudflare R2 / S3) - media migration
# Leave blank to keep local-disk uploads under UPLOADS_DIR.
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
