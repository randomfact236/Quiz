# Content push configuration — copy to scripts/content-push.env and fill in.
# NEVER commit the real file (it is gitignored) and never paste these in chat.
# The login is the LIVE site's admin account (pigzap.com/admin), not local.

LIVE_API_BASE=https://api.pigzap.com/api/v1
LIVE_ADMIN_EMAIL=
LIVE_ADMIN_PASSWORD=

# Optional overrides (defaults shown)
# LOCAL_CONTAINER=ai-quiz-postgres
# LOCAL_DB=aiquiz
# LOCAL_DB_USER=aiquiz
