#!/usr/bin/env sh
# lint-staged races a concurrent session's commits: it backs the working tree
# up with `git stash`, and if HEAD moves in that window the whole commit dies
# with "fatal: cannot lock ref 'HEAD'". The window is a second or two, so
# retry rather than fail the commit outright. lint-staged restores its stash
# before returning (even on failure), so a retry is safe.
#
# If it still fails, the message says what to do by hand instead of leaving a
# stash behind and a confusing half-applied state.

attempt=1
max=3

while [ "$attempt" -le "$max" ]; do
  if npx lint-staged; then
    exit 0
  fi
  if [ "$attempt" -lt "$max" ]; then
    echo "pre-commit: lint-staged failed (attempt ${attempt}/${max}) — another session may be committing; retrying in 3s" >&2
    attempt=$((attempt + 1))
    sleep 3
  fi
done

echo "" >&2
echo "pre-commit: lint-staged failed after ${max} attempts." >&2
echo "  If another session is committing right now, wait for it and re-run:" >&2
echo "    git commit" >&2
echo "  Or run the tasks by hand, then commit with --no-verify." >&2
exit 1
