# Staging secrets — copy to `.env.staging` (gitignored) and fill in.
# `docker-compose.staging.yml` reads this file and fails closed on any missing
# value, so the stack will not boot with a placeholder secret.
#
# Generate each secret with:  openssl rand -base64 48

STAGING_POSTGRES_PASSWORD=
STAGING_REDIS_PASSWORD=

# Must be >= 32 chars; the backend refuses to boot otherwise.
# NOTE: do NOT reuse the production value — a staging secret that leaks must
# not be a production signing key.
STAGING_JWT_SECRET=

# Signs anonymous guest identities. Keep it DISTINCT from STAGING_JWT_SECRET.
STAGING_GUEST_TOKEN_SECRET=

# From the Google Cloud console, with the staging callback registered:
#   http://localhost:3013/api/v1/auth/google/callback
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_SECRET=
