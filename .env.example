# =============================================================================
# AI Quiz Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# 
# IMPORTANT: Never commit .env file to version control!
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=production

# =============================================================================
# Port Configuration (Required ports only)
# =============================================================================
FRONTEND_PORT=3010
BACKEND_PORT=3012
DB_PORT=5432
REDIS_PORT=6379

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aiquiz
# SECURITY: Change this to a strong password in production!
DB_PASSWORD=change_this_to_secure_password_123
DB_DATABASE=aiquiz

# Optional: Enable query logging (only in development)
# DB_LOGGING=false

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# SECURITY: Set a strong password for production Redis
REDIS_PASSWORD=change_this_redis_password_456

# =============================================================================
# JWT Authentication
# =============================================================================
# SECURITY: Generate a strong random secret! Use:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_key_min_64_chars_long_for_security

# Signs anonymous guest identities (likes, comments, duel players, session
# history). The backend falls back to JWT_SECRET when this is unset, which
# works — but keep them SEPARATE so a leaked guest secret is not also a JWT
# signing key, and so rotating one does not invalidate every visitor's session.
# REQUIRED in production: with neither set, the backend refuses to boot.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
GUEST_TOKEN_SECRET=

# =============================================================================
# API Configuration
# =============================================================================
# URL that the frontend uses to call the backend API
NEXT_PUBLIC_API_URL=http://localhost:3012/api

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3010,http://localhost,http://localhost:80

# Frontend origin used for OAuth redirects and verification/reset email links
# (required in production; must be a single origin, not a list)
FRONTEND_URL=http://localhost:3010

# =============================================================================
# Email Configuration (Optional — verification & password-reset emails via Resend;
# without RESEND_API_KEY the backend logs emails to the console instead)
# =============================================================================
# RESEND_API_KEY=
# FROM_EMAIL=noreply@aiquiz.com

# =============================================================================
# Development Only (do not use in production)
# =============================================================================
# DEBUG=true
# DISABLE_AUTH=false

# ============================================
# MEDIA OBJECT STORAGE (Cloudflare R2 / S3) - media migration
# Leave blank to keep local-disk uploads under UPLOADS_DIR.
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
